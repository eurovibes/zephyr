/dts-v1/;
#include <st/f1/stm32f103Xb.dtsi>
#include <st/f1/stm32f103r(8-b)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/display/panel.h>

/ {
	aliases {
		led0 = &user_led_0;
                led1 = &user_led_1;
		led2 = &user_led_2;
		sw0 = &ok_button;
		watchdog0 = &iwdg;
		die-temp0 = &die_temp;
	};

	model = "Eurovibes Rack Serial Adapter Tester Board";
	compatible = "eurovibes,rack-ser-adapter-tester";

	chosen {
		zephyr,console = &usart1;
		zephyr,log-uart = &log_uarts;
		zephyr,shell-uart = &usart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,display = &ili9488_msp3520;
                zephyr,touch = &xpt2046_msp3520;
	};

	gpio_keys {
		compatible = "gpio-keys";

		ok_button: button0 {
			label = "OK";
			gpios = <&gpioa 8 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_0>;
		};

		up_button: button1 {
			label = "UP";
			gpios = <&gpioa 0 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_1>;
		};

		down_button: button2 {
			label = "DOWN";
			gpios = <&gpioa 1 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_2>;
		};

		left_button: button3 {
			label = "LEFT";
			gpios = <&gpioa 2 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_3>;
		};

		right_button: button4 {
			label = "RIGHT";
			gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_4>;
		};
	};

	leds: leds {
                compatible = "gpio-leds";

                user_led_0: led_0 {
                        gpios = <&gpio_exp2 13 GPIO_ACTIVE_HIGH>;
                        label = "User LD0";
                };

                user_led_1: led_1 {
                        gpios = <&gpio_exp2 14 GPIO_ACTIVE_HIGH>;
                        label = "User LD1";
                };

		user_led_2: led_2 {
                        gpios = <&gpio_exp2 15 GPIO_ACTIVE_HIGH>;
                        label = "User LD3";
                };
        };

	msp3520_mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
                dc-gpios = <&gpiob 9 GPIO_ACTIVE_HIGH>;
                reset-gpios = <&gpiob 5 GPIO_ACTIVE_LOW>;
                spi-dev = <&spi2>;
                write-only;
                #address-cells = <1>;
                #size-cells = <0>;

		ili9488_msp3520: ili9488@0 {
			compatible = "ilitek,ili9488";
			mipi-max-frequency = <25000000>;
			reg = <0>;
			pixel-format = <PANEL_PIXEL_FORMAT_RGB_888>;
			width = <320>;
			height = <480>;
			rotation = <0>;
		};
	};

	log_uarts: log_uarts {
		compatible = "zephyr,log-uart";
		uarts = <&usart1>;
	};
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(8)>;
	status = "okay";
};

&clk_lsi {
	status = "okay";
};

&die_temp {
	status = "okay";
};

&flash0 {
	partitions {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(34)>;
		};

		slot0_partition: partition@8800 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00008800 DT_SIZE_K(45)>;
		};

		slot1_partition: partition@13c00 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x00013c00 DT_SIZE_K(46)>;
		};

		storage_partition: partition@1f400 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x0001f400 DT_SIZE_K(3)>;
		};
	};
};

&i2c1 {
	pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
	pinctrl-names = "default";
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;

	gpio_exp1: pca9539@26 {
		compatible = "nxp,pca9539";
		reg = <0x26>;
		int-gpios = <&gpioa 12 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpioa 13 GPIO_ACTIVE_LOW>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <16>;
	};

	gpio_exp2: pca9539@27 {
		compatible = "nxp,pca9539";
		reg = <0x27>;
		int-gpios = <&gpiob 1 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpiob 0 GPIO_ACTIVE_LOW>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <16>;
	};
};

&i2c2 {
	pinctrl-0 = <&i2c2_scl_pb10 &i2c2_sda_pb11>;
	pinctrl-names = "default";
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;

	eeprom0: eeprom@56 {
		compatible = "atmel,at24";
		reg = <0x56>;
		status = "okay";
		size = <DT_SIZE_K(512)>;
		pagesize = <128>;
		address-width = <16>;
		timeout = <5>;
	};

	eeprom1: eeprom@57 {
		compatible = "atmel,at24";
		reg = <0x57>;
		status = "okay";
		size = <DT_SIZE_K(512)>;
		pagesize = <128>;
		address-width = <16>;
		timeout = <5>;
		wp-gpios = <&gpioa 11 GPIO_ACTIVE_LOW>;
	};
};

&iwdg {
	status = "okay";
};

&pll {
	mul = <9>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(72)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <2>;
	apb2-prescaler = <1>;
	/* usbpre not set: USB clock = 72 / 1.5: 48MHz */
};

&rtc {
	clocks = <&rcc STM32_CLOCK(APB1, 28)>,
		 <&rcc STM32_SRC_LSI RTC_SEL(2)>;
	status = "okay";
};

&spi1 {
	pinctrl-0 = <&spi1_sck_master_pa5 &spi1_miso_master_pa6 &spi1_mosi_master_pa7>;
	pinctrl-names = "default";
	status = "okay";
	cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;

	sdhc0: sdhc@0 {
                compatible = "zephyr,sdhc-spi-slot";
                reg = <0>;
                spi-max-frequency = <DT_FREQ_M(24)>;
                status = "okay";

                sdmmc {
                        compatible = "zephyr,sdmmc-disk";
                        disk-name = "SD";
                        status = "okay";
                };
	};
};

&spi2 {
	pinctrl-0 = <&spi2_sck_master_pb13 &spi2_miso_master_pb14 &spi2_mosi_master_pb15>;
	pinctrl-names = "default";
	cs-gpios = <&gpiob  4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
		   <&gpioc 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; 
	status = "okay";

	xpt2046_msp3520: xpt2046@1 {
		compatible = "xptek,xpt2046";
		status = "okay";
		reg = <1>;
		spi-max-frequency = <DT_FREQ_M(24)>;
		int-gpios = <&gpiob 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		touchscreen-size-x = <480>;
		touchscreen-size-y = <320>;
		min-x = <0>;
		min-y = <0>;
		max-x = <1000>;
		max-y = <1000>;
	};
};

&timers1 {
	st,prescaler = <10000>;
	status = "okay";

	pwm1: pwm {
		status = "okay";
		pinctrl-0 = <&tim1_ch1_pwm_out_pa8>;
		pinctrl-names = "default";
	};
};

&timers2 {
	st,prescaler = <255>;
	status = "okay";

	pwm2: pwm {
		status = "okay";
		pinctrl-0 = <&tim2_ch1_pwm_out_pa0>;
		pinctrl-names = "default";
	};
};

&usart1 {
	pinctrl-0 = <&usart1_tx_remap1_pb6 &usart1_rx_remap1_pb7>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&usart2 {
	pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pa3 &usart2_rts_pa1 &usart2_cts_pa0>;
	pinctrl-names = "default";
};
